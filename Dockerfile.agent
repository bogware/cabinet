FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY global.json Directory.Build.props Directory.Packages.props ./
COPY src/Cabinet.Agent/Cabinet.Agent.csproj src/Cabinet.Agent/
RUN dotnet restore src/Cabinet.Agent/Cabinet.Agent.csproj

COPY src/Cabinet.Agent/ src/Cabinet.Agent/
COPY build/release-signing.pub.pem build/
RUN dotnet publish src/Cabinet.Agent/Cabinet.Agent.csproj \
    --configuration Release \
    --output /app \
    --no-restore

FROM mcr.microsoft.com/dotnet/runtime:10.0 AS runtime
WORKDIR /app

RUN groupadd -r cabinet && useradd -r -g cabinet -s /sbin/nologin cabinet

COPY --from=build /app .

# Base images lag behind security fixes, so pick them up when building
RUN apt-get update && apt-get -y upgrade && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /app/spool /app/data && chown -R cabinet:cabinet /app

USER cabinet

ENTRYPOINT ["/app/cabinet-agent"]
