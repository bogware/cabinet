# Cabinet API Dockerfile
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS base
WORKDIR /app
EXPOSE 8080

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Copy solution and ALL project files (solution-level restore needs every referenced project)
COPY global.json Directory.Build.props Directory.Packages.props ./
COPY Cabinet.sln .
COPY src/Cabinet.Core/Cabinet.Core.csproj src/Cabinet.Core/
COPY src/Cabinet.Parsers/Cabinet.Parsers.csproj src/Cabinet.Parsers/
COPY src/Cabinet.Storage/Cabinet.Storage.csproj src/Cabinet.Storage/
COPY src/Cabinet.Query/Cabinet.Query.csproj src/Cabinet.Query/
COPY src/Cabinet.Detection/Cabinet.Detection.csproj src/Cabinet.Detection/
COPY src/Cabinet.Alerts/Cabinet.Alerts.csproj src/Cabinet.Alerts/
COPY src/Cabinet.AWS/Cabinet.AWS.csproj src/Cabinet.AWS/
COPY src/Cabinet.Database/Cabinet.Database.csproj src/Cabinet.Database/
COPY src/Cabinet.API/Cabinet.API.csproj src/Cabinet.API/
COPY src/Cabinet.CLI/Cabinet.CLI.csproj src/Cabinet.CLI/
COPY src/Cabinet.Agent/Cabinet.Agent.csproj src/Cabinet.Agent/
COPY tests/Cabinet.Tests/Cabinet.Tests.csproj tests/Cabinet.Tests/

# Restore API project and its dependencies (not full solution — avoids restoring test/CLI/agent deps)
RUN dotnet restore src/Cabinet.API/Cabinet.API.csproj

# Copy source code
COPY src/ src/

# Build API
WORKDIR /src/src/Cabinet.API
RUN dotnet build -c Release -o /app/build --no-restore

FROM build AS publish
RUN dotnet publish -c Release -o /app/publish /p:UseAppHost=false

FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .

# The base image ships neither curl nor wget; the health check needs one
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl && \
    rm -rf /var/lib/apt/lists/*

# Create directories and set permissions for non-root user
RUN mkdir -p /app/logs /app/data && \
    chown -R $APP_UID:$APP_UID /app

USER $APP_UID

ENV ASPNETCORE_URLS=http://+:8080

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD curl --fail --silent --show-error --output /dev/null http://localhost:8080/health/live || exit 1

ENTRYPOINT ["dotnet", "Cabinet.API.dll"]
