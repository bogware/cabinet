# Cabinet Docker Compose environment variables
# Copy this file to .env and set every value. Compose refuses to start with any left empty.
#
#   cp .env.example .env
#   openssl rand -hex 32   # run once per value below

# API key for the Cabinet API
CABINET_API_KEY=

# PostgreSQL password, used by the cabinet-api and postgres containers
CABINET_DB_PASSWORD=

# Redis password, used by the cabinet-api and redis containers
CABINET_REDIS_PASSWORD=

# Grafana admin password, used with the monitoring profile
CABINET_GRAFANA_PASSWORD=
