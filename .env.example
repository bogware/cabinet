# Cabinet Docker Compose Environment Variables
# Copy this file to .env and fill in the values before running docker-compose up.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your values
#   docker-compose up -d

# REQUIRED: API key for authenticating with Cabinet API
# Generate a strong random key: openssl rand -hex 32
CABINET_API_KEY=changeme-generate-a-strong-key

# PostgreSQL password (used by both cabinet-api and postgres containers)
CABINET_DB_PASSWORD=changeme-use-a-strong-password

# Grafana admin password (only used with monitoring profile)
CABINET_GRAFANA_PASSWORD=changeme-grafana-admin
