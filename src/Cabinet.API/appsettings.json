{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "Type": "SQLite",
    "ConnectionString": "Data Source=cabinet.db"
  },
  "Database": {
    "Providers": [
      {
        "Type": "PostgreSQL",
        "ConnectionString": "",
        "Enabled": false
      },
      {
        "Type": "MySQL",
        "ConnectionString": "",
        "Enabled": false
      },
      {
        "Type": "DynamoDB",
        "Region": "us-east-1",
        "TableName": "cabinet-logs",
        "Enabled": false
      }
    ],
    "RetentionDays": 30,
    "ArchiveAfterDays": 7,
    "BackupS3Bucket": ""
  },
  "ApiKeys": {
    "Keys": []
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  },
  "RateLimiting": {
    "Basic": {
      "PermitLimit": 100,
      "Window": "00:01:00"
    },
    "Professional": {
      "PermitLimit": 1000,
      "Window": "00:01:00"
    },
    "Enterprise": {
      "PermitLimit": 10000,
      "Window": "00:01:00"
    }
  },
  "HealthChecks": {
    "Enabled": true,
    "Endpoints": {
      "Health": "/health",
      "Ready": "/health/ready",
      "Live": "/health/live"
    }
  },
  "Backup": {
    "ArchivePath": "./backups",
    "RetentionDays": 30,
    "S3Bucket": "",
    "S3Prefix": "cabinet-backups/",
    "AutoBackupEnabled": false,
    "AutoBackupIntervalHours": 24
  },
  "SSO": {
    "Enabled": false,
    "Provider": "Oidc",
    "Oidc": {
      "Authority": "",
      "ClientId": "",
      "ClientSecret": "",
      "Scopes": ["openid", "profile", "email"],
      "GroupsClaim": "groups"
    },
    "RoleMappings": [],
    "AutoProvision": true,
    "DefaultRole": "Viewer"
  }
}
