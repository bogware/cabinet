{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Cabinet.Agent": "Information"
    }
  },
  "Agent": {
    "Inputs": [
      {
        "Paths": ["/var/log/syslog", "/var/log/auth.log"],
        "Recursive": false,
        "SourceType": "syslog",
        "Index": "main",
        "ExcludePatterns": ["*.gz", "*.zip", "*.bz2"]
      }
    ],
    "Output": {
      "ServerUrl": "http://localhost:5000",
      "ApiKey": "",
      "BatchSize": 100,
      "FlushIntervalSeconds": 5,
      "MaxRetries": 5,
      "TimeoutSeconds": 30,
      "VerifySsl": true,
      "MaxBufferSize": 10000,
      "SpillDirectory": "spool"
    },
    "Registry": {
      "Path": "registry.json",
      "SaveIntervalSeconds": 10
    },
    "ScanIntervalSeconds": 10,
    "Hostname": ""
  }
}
